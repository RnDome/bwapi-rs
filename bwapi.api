        fn map_hash() -> CxxString = mapHash;
        fn is_walkable(position: WalkPosition) -> bool = isWalkable;
        fn ground_height(position: TilePosition) -> i32 = getGroundHeight;
        fn is_buildable(position: TilePosition, #[default] include_buildings: bool) -> bool = isBuildable;
        fn is_visible(position: TilePosition) -> bool = isVisible;
        fn is_explored(position: TilePosition) -> bool = isExplored;
        fn has_creep(position: TilePosition) -> bool = hasCreep;
        fn has_power_precise(position: Position, #[default] unit_type: UnitType) -> bool = hasPowerPrecise;
        fn has_power(position: TilePosition, #[default] unit_type: UnitType) -> bool = hasPower;
        fn has_power_area(position: TilePosition, tile_width: i32, tile_height: i32, #[default] unit_type: UnitType) -> bool = hasPower;
        fn can_build_here(position: TilePosition, unit_type: UnitType, #[default] builder: Option<Unit>, #[default] check_explored: bool) -> bool = canBuildHere;
        fn can_make(unit_type: UnitType, #[default] builder: Option<Unit>) -> bool = canMake;
        fn can_research(tech: TechType, #[default] unit: Option<Unit>, #[default] check_can_issue_command_type: bool) -> bool = canResearch;
        fn can_upgrade(upgrade: UpgradeType, #[default] unit: Option<Unit>, #[default] check_can_issue_command_type: bool) -> bool = canUpgrade;
        fn start_locations() -> Vec<TilePosition> = getStartLocations;

        fn print(text: Fmt) = printf;
        fn send_text(text: Fmt) = sendText;
        fn send_text_ex(to_allies: bool, text: Fmt) = sendTextEx;

        fn is_in_game() -> bool = isInGame;
        fn is_multiplayer() -> bool = isMultiplayer;
        fn is_battle_net() -> bool = isBattleNet;
        fn is_paused() -> bool = isPaused;
        fn is_replay() -> bool = isReplay;
        fn pause_game() = pauseGame;
        fn resume_game() = resumeGame;
        fn leave_game() = leaveGame;
        fn restart_game() = restartGame;
        fn set_local_speed(speed: i32) = setLocalSpeed;

        #[skip = "takes a Unitset argument and the UnitCommand struct"]
        fn issue_command = issueCommand;
        #[skip = "the address changes with the UserInput flag; needed only with UserInput"]
        fn selected_units = getSelectedUnits;

        fn self_player() -> Option<Player> = self;
