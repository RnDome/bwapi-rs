// The Rust API of the bwapi crate: `cargo xtask generate` turns it into the C API
// (crates/bwapi/cpp/include/bwapi_c.h), the C++ thunks implementing it
// (crates/bwapi/cpp/generated) and Rust (crates/bwapi/src/generated).
//
// Not Rust: crates/codegen parses it with syn. Types are markers of how a value
// crosses the boundary. A declaration is `fn rust_name(args) -> Marker = cppName;`:
// the Rust name on the left, the C++ name on the right. The C++ compiler checks
// every declaration against the pinned BWAPI headers.
//
// Every public method of the BWAPI headers is either bound here or marked
// `#[skip = "reason"]`.
//
// Naming of overloads with a target: `attack_position` / `attack_unit` for
// commands; `can_x_at` (one kind of target) or `can_x_at_position` /
// `can_x_at_unit` (two kinds) for the `can*` checks; `_type` when the overload
// takes the type to build, train or research.

bwapi_api! {
    // ------------------------------------------------------------------- Unit

    #[set = "BWAPI::Unitset"]
    handle Unit = "BWAPI::UnitInterface" {
        fn id() -> i32 = getID;
        fn exists() -> bool = exists;
        fn replay_id() -> i32 = getReplayID;

        #[non_null = "an inaccessible unit belongs to the neutral player, never to null"]
        fn player() -> NonNull<Player> = getPlayer;

        fn unit_type() -> UnitType = getType;
        fn position() -> Position = getPosition;
        fn tile_position() -> TilePosition = getTilePosition;
        fn angle() -> f64 = getAngle;
        fn velocity_x() -> f64 = getVelocityX;
        fn velocity_y() -> f64 = getVelocityY;
        fn region() -> Option<Region> = getRegion;
        fn left() -> i32 = getLeft;
        fn top() -> i32 = getTop;
        fn right() -> i32 = getRight;
        fn bottom() -> i32 = getBottom;
        fn hit_points() -> i32 = getHitPoints;
        fn shields() -> i32 = getShields;
        fn energy() -> i32 = getEnergy;
        fn resources() -> i32 = getResources;
        fn resource_group() -> i32 = getResourceGroup;
        fn distance_to_position(target: Position) -> i32 = getDistance;
        fn distance_to_unit(target: Unit) -> i32 = getDistance;
        fn has_path_to_position(target: Position) -> bool = hasPath;
        fn has_path_to_unit(target: Unit) -> bool = hasPath;
        fn last_command_frame() -> i32 = getLastCommandFrame;

        #[skip = "returns the UnitCommand struct; every command has its own method"]
        fn last_command = getLastCommand;

        fn last_attacking_player() -> Option<Player> = getLastAttackingPlayer;
        fn initial_type() -> UnitType = getInitialType;
        fn initial_position() -> Position = getInitialPosition;
        fn initial_tile_position() -> TilePosition = getInitialTilePosition;
        fn initial_hit_points() -> i32 = getInitialHitPoints;
        fn initial_resources() -> i32 = getInitialResources;
        fn kill_count() -> i32 = getKillCount;
        fn acid_spore_count() -> i32 = getAcidSporeCount;
        fn interceptor_count() -> i32 = getInterceptorCount;
        fn scarab_count() -> i32 = getScarabCount;
        fn spider_mine_count() -> i32 = getSpiderMineCount;
        fn ground_weapon_cooldown() -> i32 = getGroundWeaponCooldown;
        fn air_weapon_cooldown() -> i32 = getAirWeaponCooldown;
        fn spell_cooldown() -> i32 = getSpellCooldown;
        fn defense_matrix_points() -> i32 = getDefenseMatrixPoints;
        fn defense_matrix_timer() -> i32 = getDefenseMatrixTimer;
        fn ensnare_timer() -> i32 = getEnsnareTimer;
        fn irradiate_timer() -> i32 = getIrradiateTimer;
        fn lockdown_timer() -> i32 = getLockdownTimer;
        fn maelstrom_timer() -> i32 = getMaelstromTimer;
        fn order_timer() -> i32 = getOrderTimer;
        fn plague_timer() -> i32 = getPlagueTimer;
        fn remove_timer() -> i32 = getRemoveTimer;
        fn stasis_timer() -> i32 = getStasisTimer;
        fn stim_timer() -> i32 = getStimTimer;
        fn build_type() -> UnitType = getBuildType;
        fn training_queue() -> Vec<UnitType> = getTrainingQueue;
        fn tech_type() -> TechType = getTech;
        fn upgrade_type() -> UpgradeType = getUpgrade;
        fn remaining_build_time() -> i32 = getRemainingBuildTime;
        fn remaining_train_time() -> i32 = getRemainingTrainTime;
        fn remaining_research_time() -> i32 = getRemainingResearchTime;
        fn remaining_upgrade_time() -> i32 = getRemainingUpgradeTime;
        fn build_unit() -> Option<Unit> = getBuildUnit;
        fn target() -> Option<Unit> = getTarget;
        fn target_position() -> Position = getTargetPosition;
        fn order() -> Order = getOrder;
        fn secondary_order() -> Order = getSecondaryOrder;
        fn order_target() -> Option<Unit> = getOrderTarget;
        fn order_target_position() -> Position = getOrderTargetPosition;
        fn rally_position() -> Position = getRallyPosition;
        fn rally_unit() -> Option<Unit> = getRallyUnit;
        fn addon() -> Option<Unit> = getAddon;
        fn nydus_exit() -> Option<Unit> = getNydusExit;
        fn power_up() -> Option<Unit> = getPowerUp;
        fn transport() -> Option<Unit> = getTransport;
        fn loaded_units() -> Query<Unit> = getLoadedUnits;
        fn space_remaining() -> i32 = getSpaceRemaining;
        fn carrier() -> Option<Unit> = getCarrier;
        fn interceptors() -> Query<Unit> = getInterceptors;
        fn hatchery() -> Option<Unit> = getHatchery;
        fn larva() -> Query<Unit> = getLarva;
        fn units_in_radius(radius: i32, pred: UnitFilter = "nullptr") -> Query<Unit> = getUnitsInRadius;
        fn units_in_weapon_range(weapon: WeaponType, pred: UnitFilter = "nullptr") -> Query<Unit> = getUnitsInWeaponRange;
        fn closest_unit(pred: UnitFilter = "nullptr", #[default] radius: i32) -> Option<Unit> = getClosestUnit;

        fn has_nuke() -> bool = hasNuke;
        fn is_accelerating() -> bool = isAccelerating;
        fn is_attacking() -> bool = isAttacking;
        fn is_attack_frame() -> bool = isAttackFrame;
        fn is_being_constructed() -> bool = isBeingConstructed;
        fn is_being_gathered() -> bool = isBeingGathered;
        fn is_being_healed() -> bool = isBeingHealed;
        fn is_blind() -> bool = isBlind;
        fn is_braking() -> bool = isBraking;
        fn is_burrowed() -> bool = isBurrowed;
        fn is_carrying_gas() -> bool = isCarryingGas;
        fn is_carrying_minerals() -> bool = isCarryingMinerals;
        fn is_cloaked() -> bool = isCloaked;
        fn is_completed() -> bool = isCompleted;
        fn is_constructing() -> bool = isConstructing;
        fn is_defense_matrixed() -> bool = isDefenseMatrixed;
        fn is_detected() -> bool = isDetected;
        fn is_ensnared() -> bool = isEnsnared;
        fn is_flying() -> bool = isFlying;
        fn is_following() -> bool = isFollowing;
        fn is_gathering_gas() -> bool = isGatheringGas;
        fn is_gathering_minerals() -> bool = isGatheringMinerals;
        fn is_hallucination() -> bool = isHallucination;
        fn is_holding_position() -> bool = isHoldingPosition;
        fn is_idle() -> bool = isIdle;
        fn is_interruptible() -> bool = isInterruptible;
        fn is_invincible() -> bool = isInvincible;
        fn is_in_weapon_range(target: Unit) -> bool = isInWeaponRange;
        fn is_irradiated() -> bool = isIrradiated;
        fn is_lifted() -> bool = isLifted;
        fn is_loaded() -> bool = isLoaded;
        fn is_locked_down() -> bool = isLockedDown;
        fn is_maelstrommed() -> bool = isMaelstrommed;
        fn is_morphing() -> bool = isMorphing;
        fn is_moving() -> bool = isMoving;
        fn is_parasited() -> bool = isParasited;
        fn is_patrolling() -> bool = isPatrolling;
        fn is_plagued() -> bool = isPlagued;
        fn is_repairing() -> bool = isRepairing;
        fn is_researching() -> bool = isResearching;
        fn is_selected() -> bool = isSelected;
        fn is_sieged() -> bool = isSieged;
        fn is_starting_attack() -> bool = isStartingAttack;
        fn is_stasised() -> bool = isStasised;
        fn is_stimmed() -> bool = isStimmed;
        fn is_stuck() -> bool = isStuck;
        fn is_training() -> bool = isTraining;
        fn is_under_attack() -> bool = isUnderAttack;
        fn is_under_dark_swarm() -> bool = isUnderDarkSwarm;
        fn is_under_disruption_web() -> bool = isUnderDisruptionWeb;
        fn is_under_storm() -> bool = isUnderStorm;
        fn is_powered() -> bool = isPowered;
        fn is_upgrading() -> bool = isUpgrading;
        fn is_visible(#[default] player: Option<Player>) -> bool = isVisible;
        fn is_targetable() -> bool = isTargetable;

        // Commands.
        #[skip = "takes the UnitCommand struct; every command has its own method"]
        fn issue_command = issueCommand;
        fn attack_position(target: Position, #[default] shift_queue_command: bool) -> bool = attack;
        fn attack_unit(target: Unit, #[default] shift_queue_command: bool) -> bool = attack;
        fn build(unit_type: UnitType, target: TilePosition) -> bool = build;
        fn build_addon(unit_type: UnitType) -> bool = buildAddon;
        fn train(unit_type: UnitType) -> bool = train;
        fn morph(unit_type: UnitType) -> bool = morph;
        fn research(tech: TechType) -> bool = research;
        fn upgrade(upgrade: UpgradeType) -> bool = upgrade;
        fn set_rally_point_position(target: Position) -> bool = setRallyPoint;
        fn set_rally_point_unit(target: Unit) -> bool = setRallyPoint;
        fn move_to(target: Position, #[default] shift_queue_command: bool) -> bool = move;
        fn patrol(target: Position, #[default] shift_queue_command: bool) -> bool = patrol;
        fn hold_position(#[default] shift_queue_command: bool) -> bool = holdPosition;
        fn stop(#[default] shift_queue_command: bool) -> bool = stop;
        fn follow(target: Unit, #[default] shift_queue_command: bool) -> bool = follow;
        fn gather(target: Unit, #[default] shift_queue_command: bool) -> bool = gather;
        fn return_cargo(#[default] shift_queue_command: bool) -> bool = returnCargo;
        fn repair(target: Unit, #[default] shift_queue_command: bool) -> bool = repair;
        fn burrow() -> bool = burrow;
        fn unburrow() -> bool = unburrow;
        fn cloak() -> bool = cloak;
        fn decloak() -> bool = decloak;
        fn siege() -> bool = siege;
        fn unsiege() -> bool = unsiege;
        fn lift() -> bool = lift;
        fn land(target: TilePosition) -> bool = land;
        fn load(target: Unit, #[default] shift_queue_command: bool) -> bool = load;
        fn unload(target: Unit) -> bool = unload;
        fn unload_all(#[default] shift_queue_command: bool) -> bool = unloadAll;
        fn unload_all_position(target: Position, #[default] shift_queue_command: bool) -> bool = unloadAll;
        fn right_click_position(target: Position, #[default] shift_queue_command: bool) -> bool = rightClick;
        fn right_click_unit(target: Unit, #[default] shift_queue_command: bool) -> bool = rightClick;
        fn halt_construction() -> bool = haltConstruction;
        fn cancel_construction() -> bool = cancelConstruction;
        fn cancel_addon() -> bool = cancelAddon;
        fn cancel_train(#[default] slot: i32) -> bool = cancelTrain;
        fn cancel_morph() -> bool = cancelMorph;
        fn cancel_research() -> bool = cancelResearch;
        fn cancel_upgrade() -> bool = cancelUpgrade;
        fn use_tech_position(tech: TechType, target: Position) -> bool = useTech;
        fn use_tech_unit(tech: TechType, #[default] target: Option<Unit>) -> bool = useTech;
        fn place_cop(target: TilePosition) -> bool = placeCOP;

        // Command checks.
        #[skip = "takes the UnitCommand struct; every command has its own check"]
        fn can_issue_command = canIssueCommand;
        #[skip = "takes the UnitCommand struct; every command has its own check"]
        fn can_issue_command_grouped = canIssueCommandGrouped;
        // Every check flag defaults to true: `can_x(…)` runs all checks, `can_x_with(…)`
        // can skip the ones the caller has already done.
        fn can_command() -> bool = canCommand;
        fn can_command_grouped(#[default] check_commandibility: bool) -> bool = canCommandGrouped;
        fn can_issue_command_type(command_type: UnitCommandType, #[default] check_commandibility: bool) -> bool = canIssueCommandType;
        fn can_issue_command_type_grouped(command_type: UnitCommandType, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canIssueCommandTypeGrouped;
        fn can_target_unit(target: Unit, #[default] check_commandibility: bool) -> bool = canTargetUnit;
        fn can_attack(#[default] check_commandibility: bool) -> bool = canAttack;
        fn can_attack_at_position(target: Position, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canAttack;
        fn can_attack_at_unit(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canAttack;
        fn can_attack_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canAttackGrouped;
        fn can_attack_grouped_at_position(target: Position, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canAttackGrouped;
        fn can_attack_grouped_at_unit(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canAttackGrouped;
        fn can_attack_move(#[default] check_commandibility: bool) -> bool = canAttackMove;
        fn can_attack_move_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canAttackMoveGrouped;
        fn can_attack_unit(#[default] check_commandibility: bool) -> bool = canAttackUnit;
        fn can_attack_unit_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canAttackUnit;
        fn can_attack_unit_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canAttackUnitGrouped;
        fn can_attack_unit_grouped_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canAttackUnitGrouped;
        fn can_build(#[default] check_commandibility: bool) -> bool = canBuild;
        fn can_build_type(unit_type: UnitType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canBuild;
        fn can_build_at(unit_type: UnitType, target: TilePosition, #[default] check_target_unit_type: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canBuild;
        fn can_build_addon(#[default] check_commandibility: bool) -> bool = canBuildAddon;
        fn can_build_addon_type(unit_type: UnitType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canBuildAddon;
        fn can_train(#[default] check_commandibility: bool) -> bool = canTrain;
        fn can_train_type(unit_type: UnitType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canTrain;
        fn can_morph(#[default] check_commandibility: bool) -> bool = canMorph;
        fn can_morph_type(unit_type: UnitType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canMorph;
        fn can_research(#[default] check_commandibility: bool) -> bool = canResearch;
        fn can_research_type(tech: TechType, #[default] check_can_issue_command_type: bool) -> bool = canResearch;
        fn can_upgrade(#[default] check_commandibility: bool) -> bool = canUpgrade;
        fn can_upgrade_type(upgrade: UpgradeType, #[default] check_can_issue_command_type: bool) -> bool = canUpgrade;
        fn can_set_rally_point(#[default] check_commandibility: bool) -> bool = canSetRallyPoint;
        fn can_set_rally_point_at_position(target: Position, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canSetRallyPoint;
        fn can_set_rally_point_at_unit(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canSetRallyPoint;
        fn can_set_rally_position(#[default] check_commandibility: bool) -> bool = canSetRallyPosition;
        fn can_set_rally_unit(#[default] check_commandibility: bool) -> bool = canSetRallyUnit;
        fn can_set_rally_unit_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canSetRallyUnit;
        fn can_move(#[default] check_commandibility: bool) -> bool = canMove;
        fn can_move_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canMoveGrouped;
        fn can_patrol(#[default] check_commandibility: bool) -> bool = canPatrol;
        fn can_patrol_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canPatrolGrouped;
        fn can_follow(#[default] check_commandibility: bool) -> bool = canFollow;
        fn can_follow_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canFollow;
        fn can_gather(#[default] check_commandibility: bool) -> bool = canGather;
        fn can_gather_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canGather;
        fn can_return_cargo(#[default] check_commandibility: bool) -> bool = canReturnCargo;
        fn can_hold_position(#[default] check_commandibility: bool) -> bool = canHoldPosition;
        fn can_stop(#[default] check_commandibility: bool) -> bool = canStop;
        fn can_repair(#[default] check_commandibility: bool) -> bool = canRepair;
        fn can_repair_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canRepair;
        fn can_burrow(#[default] check_commandibility: bool) -> bool = canBurrow;
        fn can_unburrow(#[default] check_commandibility: bool) -> bool = canUnburrow;
        fn can_cloak(#[default] check_commandibility: bool) -> bool = canCloak;
        fn can_decloak(#[default] check_commandibility: bool) -> bool = canDecloak;
        fn can_siege(#[default] check_commandibility: bool) -> bool = canSiege;
        fn can_unsiege(#[default] check_commandibility: bool) -> bool = canUnsiege;
        fn can_lift(#[default] check_commandibility: bool) -> bool = canLift;
        fn can_land(#[default] check_commandibility: bool) -> bool = canLand;
        fn can_land_at(target: TilePosition, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canLand;
        fn can_load(#[default] check_commandibility: bool) -> bool = canLoad;
        fn can_load_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canLoad;
        fn can_unload_with_or_without_target(#[default] check_commandibility: bool) -> bool = canUnloadWithOrWithoutTarget;
        fn can_unload_at_position(target: Position, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUnloadAtPosition;
        fn can_unload(#[default] check_commandibility: bool) -> bool = canUnload;
        fn can_unload_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_position: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUnload;
        fn can_unload_all(#[default] check_commandibility: bool) -> bool = canUnloadAll;
        fn can_unload_all_position(#[default] check_commandibility: bool) -> bool = canUnloadAllPosition;
        fn can_unload_all_position_at(target: Position, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUnloadAllPosition;
        fn can_right_click(#[default] check_commandibility: bool) -> bool = canRightClick;
        fn can_right_click_at_position(target: Position, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canRightClick;
        fn can_right_click_at_unit(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canRightClick;
        fn can_right_click_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canRightClickGrouped;
        fn can_right_click_grouped_at_position(target: Position, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canRightClickGrouped;
        fn can_right_click_grouped_at_unit(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canRightClickGrouped;
        fn can_right_click_position(#[default] check_commandibility: bool) -> bool = canRightClickPosition;
        fn can_right_click_position_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canRightClickPositionGrouped;
        fn can_right_click_unit(#[default] check_commandibility: bool) -> bool = canRightClickUnit;
        fn can_right_click_unit_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canRightClickUnit;
        fn can_right_click_unit_grouped(#[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canRightClickUnitGrouped;
        fn can_right_click_unit_grouped_at(target: Unit, #[default] check_can_target_unit: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility_grouped: bool, #[default] check_commandibility: bool) -> bool = canRightClickUnitGrouped;
        fn can_halt_construction(#[default] check_commandibility: bool) -> bool = canHaltConstruction;
        fn can_cancel_construction(#[default] check_commandibility: bool) -> bool = canCancelConstruction;
        fn can_cancel_addon(#[default] check_commandibility: bool) -> bool = canCancelAddon;
        fn can_cancel_train(#[default] check_commandibility: bool) -> bool = canCancelTrain;
        fn can_cancel_train_slot(#[default] check_commandibility: bool) -> bool = canCancelTrainSlot;
        fn can_cancel_train_slot_at(slot: i32, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canCancelTrainSlot;
        fn can_cancel_morph(#[default] check_commandibility: bool) -> bool = canCancelMorph;
        fn can_cancel_research(#[default] check_commandibility: bool) -> bool = canCancelResearch;
        fn can_cancel_upgrade(#[default] check_commandibility: bool) -> bool = canCancelUpgrade;
        fn can_use_tech_with_or_without_target(#[default] check_commandibility: bool) -> bool = canUseTechWithOrWithoutTarget;
        fn can_use_tech_with_or_without_target_type(tech: TechType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTechWithOrWithoutTarget;
        fn can_use_tech_at_position(tech: TechType, target: Position, #[default] check_can_target_unit: bool, #[default] check_targets_type: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTech;
        fn can_use_tech_at_unit(tech: TechType, #[default] target: Option<Unit>, #[default] check_can_target_unit: bool, #[default] check_targets_type: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTech;
        fn can_use_tech_without_target(tech: TechType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTechWithoutTarget;
        fn can_use_tech_unit(tech: TechType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTechUnit;
        fn can_use_tech_unit_at(tech: TechType, target: Unit, #[default] check_can_target_unit: bool, #[default] check_targets_units: bool, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTechUnit;
        fn can_use_tech_position(tech: TechType, #[default] check_can_issue_command_type: bool, #[default] check_commandibility: bool) -> bool = canUseTechPosition;
