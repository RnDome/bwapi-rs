    // ---------------------------------------------------------------- typeids

    typeid UnitType = "BWAPI::UnitType" {
        fn name() -> CxxString = getName;
        fn is_valid() -> bool = isValid;
        fn race() -> Race = getRace;
        fn what_builds() -> (UnitType, i32) = whatBuilds;
        fn required_units() -> Vec<(UnitType, i32)> = requiredUnits;
        fn required_tech() -> TechType = requiredTech;
        fn cloaking_tech() -> TechType = cloakingTech;
        fn abilities() -> Vec<TechType> = abilities;
        fn upgrades() -> Vec<UpgradeType> = upgrades;
        fn armor_upgrade() -> UpgradeType = armorUpgrade;
        fn max_hit_points() -> i32 = maxHitPoints;
        fn max_shields() -> i32 = maxShields;
        fn max_energy() -> i32 = maxEnergy;
        fn armor() -> i32 = armor;
        fn mineral_price() -> i32 = mineralPrice;
        fn gas_price() -> i32 = gasPrice;
        fn build_time() -> i32 = buildTime;
        fn supply_required() -> i32 = supplyRequired;
        fn supply_provided() -> i32 = supplyProvided;
        fn space_required() -> i32 = spaceRequired;
        fn space_provided() -> i32 = spaceProvided;
        fn build_score() -> i32 = buildScore;
        fn destroy_score() -> i32 = destroyScore;
        fn size() -> UnitSizeType = size;
        fn tile_width() -> i32 = tileWidth;
        fn tile_height() -> i32 = tileHeight;
        fn tile_size() -> TilePosition = tileSize;
        fn dimension_left() -> i32 = dimensionLeft;
        fn dimension_up() -> i32 = dimensionUp;
        fn dimension_right() -> i32 = dimensionRight;
        fn dimension_down() -> i32 = dimensionDown;
        fn width() -> i32 = width;
        fn height() -> i32 = height;
        fn seek_range() -> i32 = seekRange;
        fn sight_range() -> i32 = sightRange;
        fn ground_weapon() -> WeaponType = groundWeapon;
        fn max_ground_hits() -> i32 = maxGroundHits;
        fn air_weapon() -> WeaponType = airWeapon;
        fn max_air_hits() -> i32 = maxAirHits;
        fn top_speed() -> f64 = topSpeed;
        fn acceleration() -> i32 = acceleration;
        fn halt_distance() -> i32 = haltDistance;
        fn turn_radius() -> i32 = turnRadius;
        fn can_produce() -> bool = canProduce;
        fn can_attack() -> bool = canAttack;
        fn can_move() -> bool = canMove;
        fn is_flyer() -> bool = isFlyer;
        fn regenerates_hp() -> bool = regeneratesHP;
        fn is_spellcaster() -> bool = isSpellcaster;
        fn has_permanent_cloak() -> bool = hasPermanentCloak;
        fn is_invincible() -> bool = isInvincible;
