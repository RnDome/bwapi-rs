        fn last_event_time() -> i32 = getLastEventTime;
        fn set_reveal_all(#[default] reveal: bool) -> bool = setRevealAll;
        fn build_location(unit_type: UnitType, desired_position: TilePosition, #[default] max_range: i32, #[default] creep: bool) -> TilePosition = getBuildLocation;
