        fn set_text_size(#[default] size: TextSize) = setTextSize;
        fn draw_text(ctype: CoordinateType, x: i32, y: i32, text: Fmt) = drawText;
        fn draw_text_map(position: Position, text: Fmt) = drawTextMap;
        fn draw_text_mouse(position: Position, text: Fmt) = drawTextMouse;
        fn draw_text_screen(position: Position, text: Fmt) = drawTextScreen;
        fn draw_box(ctype: CoordinateType, left: i32, top: i32, right: i32, bottom: i32, color: Color, #[default] is_solid: bool) = drawBox;
        fn draw_box_map(left_top: Position, right_bottom: Position, color: Color, #[default] is_solid: bool) = drawBoxMap;
        fn draw_box_mouse(left_top: Position, right_bottom: Position, color: Color, #[default] is_solid: bool) = drawBoxMouse;
        fn draw_box_screen(left_top: Position, right_bottom: Position, color: Color, #[default] is_solid: bool) = drawBoxScreen;
        fn draw_triangle(ctype: CoordinateType, ax: i32, ay: i32, bx: i32, by: i32, cx: i32, cy: i32, color: Color, #[default] is_solid: bool) = drawTriangle;
        fn draw_triangle_map(a: Position, b: Position, c: Position, color: Color, #[default] is_solid: bool) = drawTriangleMap;
        fn draw_triangle_mouse(a: Position, b: Position, c: Position, color: Color, #[default] is_solid: bool) = drawTriangleMouse;
        fn draw_triangle_screen(a: Position, b: Position, c: Position, color: Color, #[default] is_solid: bool) = drawTriangleScreen;
        fn draw_circle(ctype: CoordinateType, x: i32, y: i32, radius: i32, color: Color, #[default] is_solid: bool) = drawCircle;
        fn draw_circle_map(position: Position, radius: i32, color: Color, #[default] is_solid: bool) = drawCircleMap;
        fn draw_circle_mouse(position: Position, radius: i32, color: Color, #[default] is_solid: bool) = drawCircleMouse;
        fn draw_circle_screen(position: Position, radius: i32, color: Color, #[default] is_solid: bool) = drawCircleScreen;
        fn draw_ellipse(ctype: CoordinateType, x: i32, y: i32, xrad: i32, yrad: i32, color: Color, #[default] is_solid: bool) = drawEllipse;
        fn draw_ellipse_map(position: Position, xrad: i32, yrad: i32, color: Color, #[default] is_solid: bool) = drawEllipseMap;
        fn draw_ellipse_mouse(position: Position, xrad: i32, yrad: i32, color: Color, #[default] is_solid: bool) = drawEllipseMouse;
        fn draw_ellipse_screen(position: Position, xrad: i32, yrad: i32, color: Color, #[default] is_solid: bool) = drawEllipseScreen;
        fn draw_dot(ctype: CoordinateType, x: i32, y: i32, color: Color) = drawDot;
        fn draw_dot_map(position: Position, color: Color) = drawDotMap;
        fn draw_dot_mouse(position: Position, color: Color) = drawDotMouse;
        fn draw_dot_screen(position: Position, color: Color) = drawDotScreen;
        fn draw_line(ctype: CoordinateType, x1: i32, y1: i32, x2: i32, y2: i32, color: Color) = drawLine;
        fn draw_line_map(a: Position, b: Position, color: Color) = drawLineMap;
        fn draw_line_mouse(a: Position, b: Position, color: Color) = drawLineMouse;
        fn draw_line_screen(a: Position, b: Position, color: Color) = drawLineScreen;

