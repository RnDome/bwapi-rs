        fn set_map(map_file_name: CStr) -> bool = setMap;
        fn set_frame_skip(frame_skip: i32) = setFrameSkip;
        fn has_path(source: Position, destination: Position) -> bool = hasPath;
        fn set_alliance(player: Player, #[default] allied: bool, #[default] allied_victory: bool) -> bool = setAlliance;
        fn set_vision(player: Player, #[default] enabled: bool) -> bool = setVision;
