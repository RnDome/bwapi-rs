        fn bullets() -> Set<Bullet> = getBullets;
        fn nuke_dots() -> Vec<Position> = getNukeDots;

        #[skip = "events arrive through the Bot callbacks"]
        fn events = getEvents;

        fn force(force_id: i32) -> Option<Force> = getForce;
        fn player(player_id: i32) -> Option<Player> = getPlayer;
        fn unit(unit_id: i32) -> Option<Unit> = getUnit;
