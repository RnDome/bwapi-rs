        fn region(region_id: i32) -> Option<Region> = getRegion;
        fn game_type() -> GameType = getGameType;
        fn latency() -> i32 = getLatency;
        fn frame_count() -> i32 = getFrameCount;
        fn replay_frame_count() -> i32 = getReplayFrameCount;
        fn fps() -> i32 = getFPS;
        fn average_fps() -> f64 = getAverageFPS;
        fn mouse_position() -> Position = getMousePosition;
        fn mouse_state(button: MouseButton) -> bool = getMouseState;
        fn key_state(key: Key) -> bool = getKeyState;
        fn screen_position() -> Position = getScreenPosition;
        fn set_screen_position(position: Position) = setScreenPosition;
        fn ping_minimap(position: Position) = pingMinimap;
        fn is_flag_enabled(flag: Flag) -> bool = isFlagEnabled;
        fn enable_flag(flag: Flag) = enableFlag;
        fn units_on_tile(tile: TilePosition, pred: UnitFilter = "nullptr") -> Query<Unit> = getUnitsOnTile;
        fn units_in_rectangle(top_left: Position, bottom_right: Position, pred: UnitFilter = "nullptr") -> Query<Unit> = getUnitsInRectangle;
        fn units_in_radius(center: Position, radius: i32, pred: UnitFilter = "nullptr") -> Query<Unit> = getUnitsInRadius;
        fn closest_unit(center: Position, pred: UnitFilter = "nullptr", #[default] radius: i32) -> Option<Unit> = getClosestUnit;
        fn closest_unit_in_rectangle(center: Position, pred: UnitFilter = "nullptr", #[default] left: i32, #[default] top: i32, #[default] right: i32, #[default] bottom: i32) -> Option<Unit> = getClosestUnitInRectangle;

        #[skip = "BestUnitFilter cannot be passed from Rust yet"]
