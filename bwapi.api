        fn last_error() -> Error = getLastError;
        fn set_last_error(#[default] error: Error) -> bool = setLastError;
        fn map_width() -> i32 = mapWidth;
        fn map_height() -> i32 = mapHeight;
        fn map_file_name() -> CxxString = mapFileName;
        fn map_path_name() -> CxxString = mapPathName;
